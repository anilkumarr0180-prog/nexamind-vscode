.env
.env.*
!.env.example
*.key
*.pem
*.cert
*.crt
*.pfx
*.p12

# Logs and runtime diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS-specific metadata
.DS_Store
Thumbs.db
